<note>
    <title>Test Note with All Cases</title>
    <created>2024-12-12T10:15:30Z</created>
    <updated>2024-12-13T11:20:45Z</updated>
    <content><![CDATA[
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
      <en-note>
        <h1>Heading 1</h1>
        <h2>Heading 2</h2>
        <h3>Heading 3</h3>
        <h4>Heading 4</h4>
        <h5>Heading 5</h5>
        <h6>Heading 6</h6>

        <p>This is a paragraph with <strong>bold</strong>, <em>italic</em>, and <a href="https://example.com">a link</a>.</p>

        <en-todo checked="true">Completed task</en-todo>
        <en-todo checked="false">Incomplete task</en-todo>

        <ul>
          <li>Unordered item 1</li>
          <li>Unordered item 2</li>
        </ul>

        <ol>
          <li>Ordered item 1</li>
          <li>Ordered item 2</li>
        </ol>

        <hr />

        <p>Here is an inline image:</p>
        <en-media hash="1234567890abcdef" type="image/png" alt="Inline Image" />

        <p>Here is some code:</p>
        <pre><code>console.log('Hello, world!');</code></pre>

        <span>This span will be ignored.</span>
        <font>This font tag will also be ignored.</font>
      </en-note>
    ]]></content>
